# Servidor llama.cpp fijado por digest con el modelo aprobado incorporado.
FROM ghcr.io/ggml-org/llama.cpp:server@sha256:8c74db29f1a2bef3f0a331b52c4d6214601dfceed4bee0b94cc48b3b23ff257d
ARG APP_REVISION=desarrollo
LABEL org.opencontainers.image.source="https://github.com/incubadoradesarrollo-source/B-LIZARD-JUDGE" \
      org.opencontainers.image.revision="${APP_REVISION}"
COPY tutor_engine/modelo/model.gguf /models/model.gguf
